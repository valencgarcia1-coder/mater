# Where the dashboard reaches the detector's API
NEXT_PUBLIC_DETECTOR_URL=http://127.0.0.1:5050

# Supabase (optional). Both must be set to turn on login and the alerts inbox;
# leave them blank and the dashboard works as before. The anon/publishable key
# is meant to be public - never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
